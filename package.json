{
  "name": "easypr",
  "displayName": "EasyPR",
  "version": "0.1.0",
  "description": "Adds a categorized view (Core, Tests, Docs, ...) to GitHub's PR file tree.",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "manifest": {
    "host_permissions": [
      "https://github.com/*",
      "https://patch-diff.githubusercontent.com/*",
      "https://api.typesafe.ai/*",
      "https://api.openai.com/*"
    ],
    "permissions": [
      "storage"
    ]
  },
  "icon": "assets/icon.png",
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.2",
    "vitest": "^2.1.8"
  }
}
